{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magazyn2",
  "account_id": "98a3d293f841838f516a14de572e6845",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-06",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magazyn",
      "database_id": "47f90ae5-794b-4e62-9247-250bbb3799eb",
      "migrations_dir": "migrations"
    }
  ],
  // Daily push reminders at 06:17 UTC (07:17 in winter / 08:17 in summer, Polish time).
  "triggers": { "crons": ["17 6 * * *"] },
  "observability": { "enabled": true }
}
